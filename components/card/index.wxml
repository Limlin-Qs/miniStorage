<view class="home-card" bindtap="onCardTap">
  <image class="home-card__image" src="{{displayUrl}}" mode="aspectFill" lazy-load wx:if="{{displayUrl}}" />
  <view class="home-card__image home-card__image--empty" wx:else>
    <text class="home-card__image-placeholder">暂无图片</text>
  </view>
  <view class="home-card__info">
    <text>{{displayDesc}}</text>
    <view class="home-card__tag-group">
      <t-tag wx:for="{{displayTags}}" wx:key="index" size="small" variant="light" theme="{{item.theme}}">{{item.text}}</t-tag>
    </view>
  </view>
</view>
