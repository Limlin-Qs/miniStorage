<t-navbar title="{{statusText}}" left-arrow />
<view class="my-content-list">
  <view class="content-item" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="goToDetail">
    <image class="content-cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="content-cover content-cover--empty" wx:else>
      <t-icon name="image" size="48rpx" color="#bbb" />
    </view>
    <view class="content-info">
      <text class="content-name">{{item.name}}</text>
      <view class="content-meta">
        <t-tag size="small" variant="light" theme="{{item.status === 'published' ? 'primary' : item.status === 'draft' ? 'default' : 'warning'}}">{{item.statusText}}</t-tag>
        <text class="content-time" wx:if="{{item.updateTime}}">{{item.updateTime}}</text>
      </view>
      <view class="content-tags" wx:if="{{item.tags.length > 0}}">
        <text class="content-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
      </view>
    </view>
  </view>

  <view class="list-loading" wx:if="{{loading}}">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>
  <view class="list-empty" wx:if="{{!loading && list.length === 0}}">
    <t-empty icon="folder-open" description="暂无内容" />
  </view>
  <view class="list-nomore" wx:if="{{!hasMore && list.length > 0 && !loading}}">
    <text>— 没有更多了 —</text>
  </view>
</view>
