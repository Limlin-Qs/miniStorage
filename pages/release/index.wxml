<t-navbar title="发布动态" left-arrow />
<view class="page">
  <view class="release-container">
    <view class="illustrate box">项目图例</view>
    <view class="upload box">
      <t-upload t-class="upload-class" media-type="{{['image']}}" files="{{originFiles}}" gridConfig="{{gridConfig}}" bind:success="handleSuccess" bind:remove="handleRemove" max="4" />
    </view>
    <view class="desc box">
      <view class="desc-label">添加描述</view>
      <t-textarea t-class="desc-class" t-class-textarea="placeholder-class" placeholder="分享项目的创作思路" maxlength="500" disableDefaultPadding="{{true}}" indicator />
    </view>
    <view class="taggroup box">
      <t-cell t-class-title="cell-title-class" t-class-note="cell-note-class" title="添加标签">
        <block wx:for="{{tags}}" wx:key="index">
          <t-check-tag t-class="tag-class" size="medium" default-checked="{{index===0}}" variant="dark" content="#{{item}}" slot="note" />
        </block>
      </t-cell>
    </view>
    <!-- 加入部门信息、项目信息、项目团队等信息输入 -->
    <view class="info box">
      <view class="info__input">
        <!-- 部门信息 -->
        <t-input 
          placeholder="请输入所属部门"
          value="{{formData.department}}"
          bindchange="onDepartmentChange">
          <view slot="label" class="custom-label"> 所属部门 </view>
        </t-input>
        <!-- 项目信息 -->
        <t-input 
          placeholder="请输入项目名称"
          value="{{formData.projectName}}"
          bindchange="onProjectNameChange">
          <view slot="label" class="custom-label"> 项目名称 </view>
        </t-input>
        <!-- <t-input 
          placeholder="例如：进行中 / 已完成 / 规划中"
          value="{{formData.projectStatus}}"
          bindchange="onProjectStatusChange">
          <view slot="label" class="custom-label"> 项目进度 </view>
        </t-input> -->
        <t-input 
          placeholder="请输入项目团队"
          value="{{formData.projectLeader}}"
          bindchange="onProjectLeaderChange">
          <view slot="label" class="custom-label"> 项目团队 </view>
        </t-input>
        <t-input 
          placeholder="请输入团队成员，用逗号分隔"
          value="{{formData.teamMembers}}"
          bindchange="onTeamMembersChange">
          <view slot="label" class="custom-label"> 团队成员 </view>
        </t-input>
        <t-input 
          placeholder="请输入负责人联系电话"
          type="number"
          value="{{formData.contact}}"
          bindchange="onContactChange">
          <view slot="label" class="custom-label"> 联系方式 </view>
        </t-input>
      </view>
    </view>
    <view class="location box">
      <t-cell title="所在位置" hover arrow leftIcon="location" bindtap="gotoMap" />
    </view>
    <view class="btngroup box">
      <t-button t-class="btn-class" theme="light" icon="file-copy" content="存草稿" size="large" bindtap="saveDraft"></t-button>
      <t-button t-class="btn-class" theme="primary" icon="upload" content="发布" size="large" bindtap="release"></t-button>
    </view>
  </view>
</view>